<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_purple_background"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/launcher_artwork_description"
        android:scaleType="fitCenter"
        android:src="@drawable/lc_launcher" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/_24sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/pt_root_ui_bold"
            android:gravity="center"
            android:text="@string/server_name"
            android:textColor="@color/launcher_white"
            android:textSize="@dimen/_24sdp" />

        <TextView
            android:id="@+id/serverAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/pt_root_ui_medium"
            android:gravity="center"
            android:textColor="@color/launcher_white"
            android:textSize="@dimen/_16sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:fontFamily="@font/pt_root_ui_medium"
            android:gravity="center"
            android:text="@string/connect_hint"
            android:textColor="@color/launcher_white"
            android:textSize="@dimen/_12sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_32sdp"
            android:fontFamily="@font/pt_root_ui_medium"
            android:gravity="center"
            android:text="@string/launcher_credit"
            android:textColor="@color/launcher_purple_light"
            android:textSize="@dimen/_10sdp" />
    </LinearLayout>
</LinearLayout>
